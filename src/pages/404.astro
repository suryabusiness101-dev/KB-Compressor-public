---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page Not Found | KB Compressor"
  description="This page doesn't exist. Head back to the KB Compressor tool."
>
  <section class="mx-auto flex max-w-xl flex-col items-center px-4 py-24 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600 dark:text-indigo-400">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
      This page doesn't exist
    </h1>
    <p class="mt-4 text-slate-600 dark:text-slate-300">
      The link you followed may be broken, or the page may have moved. Try the compressor
      directly, or head back home.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-indigo-500"
      >
        Go to the compressor
      </a>
      <a
        href="/passport-visa-photo-size"
        class="rounded-lg border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 hover:border-indigo-400 dark:border-slate-700 dark:text-slate-200"
      >
        Passport &amp; visa photos
      </a>
    </div>
  </section>
</Layout>
